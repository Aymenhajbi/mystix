# Mystix - local development environment, shared by every workstation through git.
# Create your .env with:  powershell -ExecutionPolicy Bypass -File scriptsinit-env.ps1
# It copies this file and generates the values marked <generated> (local passwords, JWT secret). .env stays
# git-ignored: it holds passwords, and the CI refuses any committed .env. Everything else is the same everywhere.

# --- PostgreSQL (docker-compose.dev.yml) ---
POSTGRES_DB=mystix
POSTGRES_USER=mystix
POSTGRES_PASSWORD=<generated>
# 5434: 5432 is often taken by another local PostgreSQL.
POSTGRES_PORT=5434

# --- Backend (Spring Boot relaxed binding) ---
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/mystix
SPRING_DATASOURCE_USERNAME=mystix
# Same value as POSTGRES_PASSWORD (init-env.ps1 copies it).
SPRING_DATASOURCE_PASSWORD=<generated>
MYSTIX_JWT_SECRET=<generated>
SERVER_PORT=8080

# --- Clearance DGI ---
# Always SIMULATED until official DGI specs are published. TODO(DGI-SPEC)
MYSTIX_CLEARANCE_MODE=simulated
# Directory of the channel secrets (one file per credential_ref: SFTP password, AS2 private key), git-ignored.
# init-env.ps1 sets it to <repo>.localsecrets (absolute path).
MYSTIX_SECRETS_DIRECTORY=<generated>

# --- Artefact storage (ADR-0017) ---
# database (default) or s3. With s3, the dev MinIO (profile storage): endpoint http://127.0.0.1:9000, bucket
# mystix-artifacts (created with object lock by minio-init). Use a dedicated access key, not the MinIO root, outside dev.
MYSTIX_STORAGE_MODE=database
MYSTIX_STORAGE_ENDPOINT=
MYSTIX_STORAGE_ACCESS_KEY=
MYSTIX_STORAGE_SECRET_KEY=
MYSTIX_STORAGE_RETENTION_DAYS=0

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- MinIO (profile "storage", Lot 4) ---
MINIO_ROOT_USER=mystix-minio
MINIO_ROOT_PASSWORD=<generated>
MINIO_BUCKET=mystix-artifacts
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- AS2 test partner (tools/as2-test, Node.js) ---
AS2_TEST_PARTNER_URL=http://127.0.0.1:4080/as2
