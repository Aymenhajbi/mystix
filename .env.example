# Mystix - local development environment. Copy to .env and fill in.
#   cp .env.example .env        (Git Bash)   |   Copy-Item .env.example .env   (PowerShell)
# .env is git-ignored. NEVER commit real values. Use local-only throwaway passwords.

# --- PostgreSQL (docker-compose.dev.yml) ---
POSTGRES_DB=mystix
POSTGRES_USER=mystix
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# --- Backend (Spring Boot relaxed binding) ---
# ASSUMPTION: standard spring.datasource.* keys. Confirm against application*.yml in Lot 0.
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mystix
SPRING_DATASOURCE_USERNAME=mystix
SPRING_DATASOURCE_PASSWORD=change-me-local-only
# ASSUMPTION: property name of the JWT secret is unknown until the audit. Generate with:
#   openssl rand -base64 48
MYSTIX_JWT_SECRET=
SERVER_PORT=8080

# --- Clearance DGI ---
# Always SIMULATED until official DGI specs are published. TODO(DGI-SPEC)
MYSTIX_CLEARANCE_MODE=simulated

# --- Frontend (Next.js) ---
# ASSUMPTION: variable name used by the frontend to reach the API. Confirm in Lot 0.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- MinIO (profile "storage", Lot 4) ---
MINIO_ROOT_USER=mystix-minio
MINIO_ROOT_PASSWORD=change-me-local-only-min8chars
MINIO_BUCKET=mystix-artifacts
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- AS2 test partner (tools/as2-test, Node.js) ---
AS2_TEST_PARTNER_URL=http://127.0.0.1:4080/as2
